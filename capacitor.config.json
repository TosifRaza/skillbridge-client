{
  "appId": "com.skillbridge.app",
  "appName": "SkillBridge",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#5528d6",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#5528d6",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 1600,
      "backgroundColor": "#5528d6",
      "showSpinner": false
    }
  }
}
